# Password for the projector page (/host). Required. Use something nobody in class will guess.
KDO_HOST_KEY=replace-me
# Host port for the app (put it behind your TLS reverse proxy).
KDO_WEB_PORT=6768
# Public address shown on the projector and in the QR code, e.g. https://kdoby.example.cz
# Leave empty to use whatever address the projector browser opened.
KDO_PUBLIC_URL=
# Set true when running behind a reverse proxy that sets X-Forwarded-For (needed for per-IP PIN rate limit).
KDO_TRUST_PROXY=false
