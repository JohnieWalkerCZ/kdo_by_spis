{
  "name": "kdo-by-nejspis",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/index.ts",
    "build": "esbuild client/app.ts client/host.ts client/admin.ts --bundle --splitting --format=esm --target=es2022 --outdir=public",
    "dev": "KDO_HOST_KEY=${KDO_HOST_KEY:-dev} node --watch server/index.ts",
    "dev:client": "npm run build -- --watch",
    "typecheck": "tsc -p server && tsc -p client",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
